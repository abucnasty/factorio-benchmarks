#!/usr/bin/env bash
# Single hardware thread (taskset -c 0) + mimalloc + 4 GB huge pages + ASLR off.
# Eliminates the worker pool as a source of non-determinism.
set -euo pipefail

FACTORIO_BIN="${HOME}/Games/factorio/bin/x64/factorio"
MIMALLOC_SO="${HOME}/dev/temp/mimalloc/out/release/libmimalloc.so"

export MIMALLOC_RESERVE_HUGE_OS_PAGES=4
export MIMALLOC_PURGE_DELAY=-1
export MIMALLOC_SHOW_STATS=1

FACTORIO_FLAGS=(
  "--cache-sprite-atlas=true"
)

RUNNER=()
if command -v gamemoderun >/dev/null 2>&1; then
  RUNNER=(gamemoderun)
fi

env LD_PRELOAD="${MIMALLOC_SO}" \
  setarch "$(uname -m)" -R \
  taskset -c 0 \
  "${RUNNER[@]}" \
  "${FACTORIO_BIN}" \
  "${FACTORIO_FLAGS[@]}" \
  "$@"
