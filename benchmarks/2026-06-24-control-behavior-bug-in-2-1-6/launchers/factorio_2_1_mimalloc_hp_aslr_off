#!/usr/bin/env bash
# Stacked controls: ASLR off + mimalloc + 4 GB huge pages + physical pinning.
# Builds on the conclusion of the pinning and ASLR experiments (both ruled out
# as the cause of the 2.1.6 bimodal split). This isolates the heap allocator.
set -euo pipefail

FACTORIO_BIN="${HOME}/Games/factorio_beta/bin/x64/factorio"
MIMALLOC_SO="${HOME}/dev/temp/mimalloc/out/release/libmimalloc.so"

# 4 x 1 GiB huge OS pages
export MIMALLOC_RESERVE_HUGE_OS_PAGES=4
export MIMALLOC_PURGE_DELAY=-1
export MIMALLOC_SHOW_STATS=1

FACTORIO_FLAGS=(
  "--cache-sprite-atlas=true"
)

RUNNER=()
if command -v gamemoderun >/dev/null 2>&1; then
  RUNNER=(gamemoderun)
fi

env LD_PRELOAD="${MIMALLOC_SO}" \
  setarch "$(uname -m)" -R \
  taskset -c 0-7 \
  "${RUNNER[@]}" \
  "${FACTORIO_BIN}" \
  "${FACTORIO_FLAGS[@]}" \
  "$@"
